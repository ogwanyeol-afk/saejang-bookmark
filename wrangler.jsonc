{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 워커 이름 = 주소 앞부분: https://saejang-bookmark.<내 계정>.workers.dev
  "name": "saejang-bookmark",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "saejang-bookmark" }],
  // 정해진 시각에 실행(UTC). worker.js 의 CRONS 와 같아야 합니다.
  "triggers": { "crons": ["0 11 * * SUN", "0 6 * * WED"] },
  "observability": { "enabled": true },
  // 대시보드에서 직접 넣은 변수를 배포 때 지우지 않음
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  // 비밀이 아닌 설정값. 비밀값(키)은 대시보드 Settings → Variables and Secrets 에서 Secret 으로 넣습니다.
  "vars": {
    "ADMIN_EMAILS": "ohtax4888@naver.com",
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "VAPID_SUBJECT": "mailto:ohtax4888@naver.com",
    // 유튜브 연결용 구글 OAuth 클라이언트 ID(공개값). 비밀번호는 Secret GOOGLE_CLIENT_SECRET 으로
    "GOOGLE_CLIENT_ID": "1027458011674-4v17qvo94uv1g4in62v8u0652p6bair2.apps.googleusercontent.com"
  }
}
