# Cloudflare 배포 시 어디에 넣는지
#   NEXT_PUBLIC_* → Workers Builds 의 "Build variables"(빌드 때 화면 코드에 들어감)
#   나머지 키      → 워커 Settings → Variables and Secrets 에 "Secret" 으로
#   ADMIN_EMAILS·ANTHROPIC_MODEL·VAPID_SUBJECT 는 wrangler.jsonc 의 vars 에 있음
# 내 컴퓨터 시험: NEXT_PUBLIC_* 는 .env.production.local, 나머지는 .dev.vars

# ── Supabase (supabase.com → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 관리자(상담 신청 확인·절세 팁 관리) 이메일, 쉼표로 여러 명 ──
ADMIN_EMAILS=ohtax4888@naver.com
# 상담 화면에 보일 사무실 이름
NEXT_PUBLIC_OFFICE_NAME=부산 해양세무회계

# ── Claude API (console.anthropic.com → API Keys) ──
# 비워두면 키워드 규칙으로 분류합니다(정확도 낮음).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── 도서 API (비워두면 해당 출처를 건너뜁니다) ──
# 알라딘: aladin.co.kr → Open API 신청 → TTBKey
ALADIN_TTB_KEY=
# 도서관 정보나루: data4library.kr → 인증키 신청 (서버 IP 등록 시 하루 3만 회)
LIBRARY_API_KEY=
# 국립중앙도서관: nl.go.kr → 오픈API → 인증키 신청 (사서추천도서)
NL_API_KEY=

# ── 유튜브 영상 길이 조회 (Google Cloud → YouTube Data API v3 → API 키) ──
# 비워두면 영상 1개를 평균 11분으로 계산합니다.
YOUTUBE_API_KEY=

# ── 웹 푸시 (npm run vapid 로 생성) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ohtax4888@naver.com

# ── 크론 보호용 임의 문자열 ──
CRON_SECRET=
